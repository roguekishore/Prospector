{
  "name": "prospector-web",
  "version": "1.0.0",
  "private": true,
  "description": "The two browser UIs: lead (review deck, served by src/server) and prospect (control panel, served by src/control). Built with Vite into web/dist/<app>/.",
  "type": "module",
  "scripts": {
    "dev:lead": "vite --mode lead",
    "dev:prospect": "vite --mode prospect",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:lead": "vite build --mode lead",
    "build:prospect": "vite build --mode prospect",
    "build": "npm run typecheck && npm run build:lead && npm run build:prospect",
    "preview:lead": "vite preview --mode lead",
    "preview:prospect": "vite preview --mode prospect"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
