# Required by `discover` — Google Places API (New) key.
GOOGLE_PLACES_KEY=

# Optional. Only used by the Brave fallback provider (src/discover/brave.js).
BRAVE_KEY=

# Required on the box. Hashed into Caddy's basic_auth by install.sh; the
# plaintext never reaches the control service itself.
CONTROL_PASSWORD=

# Required on the box. Hashed into Caddy's basic_auth for
# leads.themaverick.tech by install.sh, separately from CONTROL_PASSWORD: the
# deck can be read, control can spend Places quota.
DECK_PASSWORD=

# Only `./p db` reads this — mavdb's admin user, in the other account. It is
# passed to one Terraform process as a sensitive variable and is never written
# to SSM, to the box or to Terraform state (R2.4). Leave it unset on a laptop
# that will not apply terraform/db.
MAVERICK_DB_PASSWORD=
